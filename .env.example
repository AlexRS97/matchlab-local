# Aplicacion
APP_ENV=development
APP_SECRET_KEY=cambia-esta-clave-en-produccion
APP_TIMEZONE=Europe/Madrid
APP_CORS_ORIGINS=http://localhost:3000
APP_DEMO_MODE=true
APP_LOG_LEVEL=INFO

# PostgreSQL / Redis
POSTGRES_DB=football_analytics
POSTGRES_USER=football
POSTGRES_PASSWORD=football_local_password
DATABASE_URL=postgresql+psycopg://football:football_local_password@postgres:5432/football_analytics
REDIS_URL=redis://redis:6379/0

# API-Football (https://dashboard.api-football.com/)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_TIMEOUT_SECONDS=30
API_FOOTBALL_DAILY_CALL_BUDGET=7000
API_FOOTBALL_QUOTA_RESERVE=5
MAX_HISTORY_CALLS_PER_RUN=80
MAX_STATISTICS_CALLS_PER_RUN=120
MAX_ODDS_CALLS_PER_RUN=40
LEAGUE_CATALOG_CACHE_HOURS=168
TEAM_HISTORY_CACHE_HOURS=18
STANDINGS_CACHE_HOURS=12
ODDS_CACHE_HOURS=3
# Desactivado: MatchLab solo actualiza cuando tu lo solicitas.
ENABLE_SCHEDULED_INGESTION=false

# Web
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
